{
  "name": "dsh-chat-manager",
  "version": "2.0.0-alpha.1",
  "packageManager": "pnpm@11.19.0",
  "description": "DeepSeek Harness archive content search and confirmed cleanup of unloaded local sessions",
  "type": "module",
  "main": "./src/index.js",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "assets/icon.svg",
    "locale/*.json",
    "compatibility.json",
    "cordis.patch.yml",
    "lib/client.js",
    "src/index.js",
    "src/host/archive-manager.mjs",
    "src/host/delete-session.mjs",
    "README.md",
    "README.en.md",
    "README.zh-CN.md",
    "AGENTS.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test:behavior": "node --test tests/archive-manager-host.test.mjs tests/delete-session-client.test.mjs tests/delete-session-host.test.mjs tests/archive-settings.test.mjs tests/official-session-actions.test.mjs tests/smoke-ui.test.mjs",
    "test:delivery": "node --test tests/accept-official-dsh.test.mjs tests/package-contract.test.mjs tests/prepare-compat-release.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run test && pnpm run build && pnpm pack --pack-destination .artifacts",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "prepack": "node scripts/build-client.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "session-manager",
    "session-management",
    "conversation",
    "archive",
    "unarchive",
    "restore",
    "history-search",
    "chat-history",
    "conversation-history",
    "archived-sessions",
    "session-delete",
    "permanent-delete",
    "deepseek",
    "delete",
    "privacy"
  ],
  "author": "WSL043",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WSL043/dsh-chat-manager.git"
  },
  "bugs": {
    "url": "https://github.com/WSL043/dsh-chat-manager/issues"
  },
  "homepage": "https://github.com/WSL043/dsh-chat-manager#readme",
  "engines": {
    "node": ">=24.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-alpha.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "playwright": "1.63.0"
  }
}
